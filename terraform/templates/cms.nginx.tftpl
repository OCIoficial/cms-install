# Generado por Terraform. certbot agrega la configuración HTTPS (cms-https).

proxy_set_header Host $host;
proxy_set_header X-Real-IP $remote_addr;
proxy_set_header X-Forwarded-For $remote_addr;
proxy_set_header X-Forwarded-Proto $scheme;

server {
    listen 80;
    server_name ${contest};
    client_max_body_size 10M;

    location / {
        proxy_pass http://127.0.0.1:8888;
    }
}

server {
    listen 80;
    server_name ${admin};
    client_max_body_size 500M;

    location / {
        proxy_pass http://127.0.0.1:8889;
    }

    # Importador de usuarios (import-users/, servicio cms-import-users)
    location /import-users {
        proxy_pass http://127.0.0.1:8891;
    }
}

server {
    listen 80;
    server_name ${ranking};

    location / {
%{ if !ranking_public ~}
        # ranking_public = false: usuario oci, contraseña en terraform output ranking_password
        auth_basic "Ranking";
        auth_basic_user_file /etc/nginx/ranking.htpasswd;
%{ endif ~}
        proxy_pass http://127.0.0.1:8890;
        # El ranking recibe actualizaciones en vivo por una conexión abierta
        proxy_buffering off;
        proxy_read_timeout 1h;
    }
}
