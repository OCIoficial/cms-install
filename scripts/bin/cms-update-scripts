#! /usr/bin/bash
# Baja desde S3 la última versión de los scripts de despliegue (scripts.zip, con
# scripts/ del repo) e instala los comandos y servicios systemd. No reinicia CMS.
#
# Corre solo: en cada arranque, antes de cada comando que Terraform ejecuta en
# la principal, y en los workers cuando cms-contest los reinicia. Así un
# `terraform apply` con scripts cambiados llega a las máquinas que ya existen.

set -euo pipefail
. /opt/cms-deploy/lib.sh
require_root "$@"

# Una ejecución a la vez: Terraform puede ejecutar dos comandos al mismo tiempo
exec 9>/run/cms-update-scripts.lock
flock 9

# Se extrae aparte y se reemplaza la carpeta entera: los archivos que ya no
# están en el zip desaparecen
NEW=$(mktemp -d "$DEPLOY_DIR.new.XXXXXX")
s3_unzip scripts.zip "$NEW"
chmod -R a+rx "$NEW"
OLD=$(mktemp -u "$DEPLOY_DIR.old.XXXXXX")
mv "$DEPLOY_DIR" "$OLD"
mv "$NEW" "$DEPLOY_DIR"
rm -rf "$OLD"

install -m 755 "$DEPLOY_DIR"/bin/* /usr/local/bin/
install -m 644 "$DEPLOY_DIR"/systemd/*.service /etc/systemd/system/
systemctl daemon-reload
